APP_ENV=production

APP_DATABASE_URL=mysql://fishradar:change-me@your-mysql-host:3306/fishradar2?charset=utf8mb4

AUTH_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_NAME=auth_session

QUEUE_BACKEND=redis
REDIS_URL=redis://your-redis-host:6379/0
REDIS_QUEUE_NAME=fishradar2:worker_jobs
REDIS_EVENT_CHANNEL=fishradar2:events

API_HOST=0.0.0.0
API_PORT=8080
PYTHON_BIN=python3
WORKER_PY_ROOT=/app

API_GO_IMAGE=ghcr.io/life2you/fishradar2-radar-control:latest
WORKER_PY_IMAGE=ghcr.io/life2you/fishradar2-radar-probe:latest
WEB_UI_IMAGE=ghcr.io/life2you/fishradar2-radar-portal:latest
